{
  "name": "discord-organization-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "commands:register": "tsx src/infrastructure/discord/register-commands.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "discord.js": "14.27.0",
    "drizzle-orm": "0.45.2",
    "liquidjs": "10.28.0",
    "luxon": "3.7.2",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/luxon": "3.7.1",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "8.39.1",
    "@typescript-eslint/parser": "8.39.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.33.0",
    "tsx": "4.20.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
